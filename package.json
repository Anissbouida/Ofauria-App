{
  "name": "ofauria-app",
  "version": "1.0.0",
  "private": true,
  "description": "Application de gestion pour la boulangerie-pâtisserie Ofauria",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "build:shared": "npm run build --workspace=shared",
    "lint": "eslint . --ext .ts,.tsx",
    "db:migrate": "npm run migrate --workspace=server",
    "db:seed": "npm run seed --workspace=server",
    "db:seed-test-accounts": "npm run seed:test-accounts --workspace=server",
    "test:e2e-paie": "npm run e2e:paie --workspace=server --",
    "test:e2e-audit-parametres": "npm run e2e:audit-parametres --workspace=server --",
    "test:e2e-numerotation": "npm run e2e:numerotation --workspace=server --",
    "test:e2e-roles-droits": "npm run e2e:roles-droits --workspace=server --",
    "audit:droits-routes": "npm run audit:droits-routes --workspace=server --",
    "test:e2e-parametres-metier": "npm run e2e:parametres-metier --workspace=server --",
    "test:e2e-societe": "npm run e2e:societe --workspace=server --",
    "test:e2e-documents": "npm run e2e:documents --workspace=server --",
    "test:e2e-donnees": "npm run e2e:donnees --workspace=server --",
    "test:e2e-accueil-config": "npm run e2e:accueil-config --workspace=server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "jspdf": "^4.2.1"
  },
  "overrides": {
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.19.6"
  }
}
